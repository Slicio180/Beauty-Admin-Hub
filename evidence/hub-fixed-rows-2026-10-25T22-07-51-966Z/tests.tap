      .brand-logo { width: 220px; height: 76px; }
      .hub-title { font-size: 36px; }
      .event-header > div { flex-basis: 100%; }
      .event-brand-logo { width: 220px; }
    }
    
    /* Keep system health beside its navigation entry; grey means not checked. */
    .sidebar .system-status-nav { display: flex; align-items: center; gap: 12px; }
    .sidebar .system-status-nav::after { content: ""; display: inline-block; width: 11px; height: 11px; flex: 0 0 11px; border-radius: 50%; background: var(--muted); }
    .header-right { margin-left: auto; flex-shrink: 0; justify-content: flex-end; }
    .header-player-count { width: 168px; height: 128px; }
    .header-player-count strong { font-size: 72px; }
    .header-player-count span { font-size: 24px; margin-top: 8px; letter-spacing: 2px; }
    @media (max-width: 600px) {
      .header-player-count { width: 132px; height: 112px; }
      .header-player-count strong { font-size: 62px; }
      .header-player-count span { font-size: 22px; }
    }
    
    /* Larger Event Hub branding and equal spacing around the event artwork. */
    .topbar { min-height: 220px; }
    .brand-area { min-height: 140px; gap: 20px; }
    .brand-logo { width: clamp(280px, 32vw, 460px); height: 138px; }
    .hub-title { font-size: clamp(58px, 6vw, 85px); }
    .hub-divider { height: 82px; }
    .event-header { display: grid; grid-template-columns: max-content minmax(0, 1fr) max-content; gap: 20px; }
    .event-brand-logo { width: min(340px, 100%); justify-self: center; transform: translateY(-9.4%); }
    @media (max-width: 900px) {
      .brand-area { gap: 16px; }
      .brand-logo { width: 260px; height: 110px; }
      .hub-title { font-size: 58px; }
    }
    @media (max-width: 700px) {
      .brand-area { flex-wrap: wrap; }
      .brand-logo { width: 240px; height: 100px; }
      .hub-title { font-size: 48px; }
      .event-header { grid-template-columns: minmax(0, 1fr) max-content; }
      .event-header > div { grid-column: 1; grid-row: 1; }
      .event-header .event-button { grid-column: 2; grid-row: 1; }
      .event-brand-logo { grid-column: 1 / -1; grid-row: 2; width: min(320px, 100%); }
    }
    
    /* EVENT HUB is the primary page title. */
    .hub-title { font-size: clamp(68px, 8vw, 110px); line-height: 1; }
    @media (max-width: 900px) {
      .brand-area { gap: 12px; }
      .hub-title { font-size: 68px; }
    }
    @media (max-width: 700px) {
      .hub-title { font-size: 58px; }
    }
    
    /* Fit the event row around the complete artwork, without editing the PNG. */
    .event-header { margin-bottom: 16px; }
    .event-brand-logo {
      aspect-ratio: 1920 / 710;
      height: auto;
      object-fit: cover;
      object-position: center 77.3%;
      transform: none;
    }
    
    /* Readable event-operation text, retaining the original AIK font families. */
    .sidebar button { font-size: 20px; line-height: 1.25; padding: 15px 16px; }
    .label { font-size: 16px; line-height: 1.3; color: #bdbdbd; letter-spacing: 1px; }
    .event-header h2 { font-size: 32px; line-height: 1.2; }
    .event-header p { font-size: 20px; line-height: 1.35; color: #bdbdbd; }
    .workspace-header h2 { font-size: 28px; line-height: 1.2; }
    .event-button, .workspace-header button { font-size: 20px; line-height: 1.2; min-height: 48px; }
    .players-table { min-width: 1050px; }
    .players-table th { font-size: 17px; line-height: 1.3; letter-spacing: 1px; color: #bdbdbd; overflow-wrap: anywhere; }
    .players-table td { font-size: 22px; line-height: 1.35; padding: 16px; overflow-wrap: anywhere; }
    .status-select { font-size: 20px; min-height: 46px; width: 100%; max-width: 145px; }
    .consent-badge { font-size: 20px; min-height: 44px; }
    .message-read-button { font-size: 20px; min-height: 44px; }
    .health-status strong { font-size: 22px; }
    .health-card p { font-size: 18px; line-height: 1.4; }
    .health-actions, .health-actions button, .health-actions time { font-size: 18px; }
    .message-popup-label, .register-popup-label { font-size: 18px; }
    .message-popup-text { font-size: 22px; }
    </style>
      <style>.identity-overlay { position: fixed; inset: 0; z-index: 11000; display: flex; align-items: center; justify-content: center; padding: 20px; background: rgba(0,0,0,.8); }
    .identity-dialog { position: relative; width: min(620px,100%); max-height: 90vh; overflow: auto; padding: 32px; border: 2px solid #ffd700; border-radius: 14px; background: #111; color: #fff; font-family: var(--identity-body-font, 'AIK Display'), Arial, sans-serif; font-weight: var(--identity-body-weight, 400); font-size: 18px; line-height: 1.5; }
    .identity-dialog h2, .identity-name { font-family: 'AIK Display', Arial, sans-serif; font-weight: 700; color: #ffd700; overflow-wrap: anywhere; }
    .identity-close { position: absolute; top: 8px; right: 12px; background: transparent; color: #ffd700; border: 0; font-size: 32px; cursor: pointer; }
    .identity-action, .identity-cancel { display: block; width: 100%; padding: 12px; margin-top: 12px; border: 2px solid #ffd700; border-radius: 7px; font-family: 'AIK Condensed', 'AIK Display', Arial, sans-serif; font-weight: 700; font-size: 22px; line-height: 1.2; cursor: pointer; }
    .identity-action { background: #ffd700; color: #000; } .identity-cancel { background: #111; color: #fff; }
    .identity-detail { display: block; width: 100%; box-sizing: border-box; margin-top: 8px; padding: 12px; background: #fff; color: #111; border: 2px solid #ffd700; border-radius: 7px; font: inherit; }
    .identity-detail-area { margin-top: 20px; } .identity-detail-area[hidden] { display: none; }
    .identity-preview, .identity-info { overflow-wrap: anywhere; color: #ffd700; }
    .identity-dialog button:focus-visible, .identity-detail:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }
    </style>
      <style>.event-inspection { width: min(760px, calc(100vw - 40px)); max-height: 85vh; overflow-y: auto; padding-top: 35px; }
    .event-inspection h2 { font-family: 'AIK Display', Arial, sans-serif; font-weight: 700; }
    .event-inspection p, .event-inspection label { font-family: 'AIK Display', Arial, sans-serif; font-weight: 400; font-size: 18px; line-height: 1.4; }
    .event-inspection input { display: block; margin: 10px 0; padding: 10px; background: #111; color: #fff; border: 1px solid #ffdf32; font: inherit; color-scheme: dark; }
    .event-inspection button:not(.message-popup-close) { margin: 12px 12px 0 0; padding: 10px 16px; border: 0; background: #ffdf32; color: #000; font-family: 'AIK Condensed', Arial, sans-serif; font-size: 20px; }
    .event-inspection button:disabled { opacity: .45; cursor: not-allowed; }
    .event-inspection label { display: block; margin: 16px 0; }
    .event-inspection .event-acknowledgement { display: flex; gap: 12px; align-items: flex-start; }
    .event-inspection .event-acknowledgement input { display: inline-block; margin-top: 4px; width: 22px; height: 22px; flex-shrink: 0; }
    </style>
    
    <style id="beauty-fixed-player-rows-20261025">
    /* TEST Hub: independently scrolling players, with both control rows retained. */
    .players-workspace { display: flex; flex-direction: column; min-height: 0; max-height: calc(100vh - 60px); }
    .players-workspace > .workspace-header { flex: 0 0 auto; background: #111; border-radius: 9px 9px 0 0; }
    .players-workspace > .players-table-wrap { flex: 1 1 auto; min-height: 0; max-height: 60vh; overflow: auto; border-radius: 0 0 9px 9px; }
    .players-workspace .players-table { border-collapse: separate; border-spacing: 0; }
    .players-workspace .players-table th { position: -webkit-sticky; position: sticky; top: 0; z-index: 2; background: #0c0c0c; color: #fff; font-size: 24px; line-height: 1.25; letter-spacing: 1px; overflow-wrap: normal; word-break: normal; }
    </style>
    </head>
    
    <body>
      <aside class="environment-banner" role="status">
        IDENTITY TEST — separate test spreadsheet. Registration and status changes are saved here. Event date saving is disabled.
      </aside>
    
      <header class="topbar">
    
        <div class="brand-area">
          <img
            src="data:image/png;base64,"
            alt="AIK Dart"
            class="brand-logo"
          >
    
          <div class="hub-divider"></div>
    
          <div class="hub-title">EVENT HUB</div>
        </div>
    
        <div class="header-right">
    
      <div class="header-player-count">
        <strong id="playerCount">0</strong>
        <span>PLAYERS</span>
      </div>
    
    
    </div>
    
      </header>
    
    
      <div class="hub-layout">
    
        <!-- SIDEBAR -->
    
        <aside class="sidebar">
          <button class="active">Dashboard</button>
          <button>Beauty Live</button>
          <button>Register Player</button>
          <button>Event Control Details</button>
          <button>Nakka</button>
          <button class="system-status-nav" aria-label="System Status — not checked" title="System health has not been checked">System Status</button>
          <button>Instructions</button>
        </aside>
    
    
        <!-- MAIN DASHBOARD -->
    
        <main class="main-content">
    
          <!-- CURRENT EVENT -->
    
          <section class="event-header">
    
            <div>
              <span class="label">CURRENT EVENT</span>
    
              <h2 id="currentEventDate">
                NO EVENT SELECTED
              </h2>
    
              <p id="currentEventStatus">
                No event connected yet
              </p>
            </div>
    
            <img
              src="data:image/png;base64,"
              alt="AIK Måndagsdartarna — GoDartsPro.com"
              class="event-brand-logo"
            >
    
            <button class="event-button">
              EVENT CONTROL
            </button>
    
          </section>
    
    
          <!-- TONIGHT'S PLAYERS -->
    
          <section class="workspace players-workspace">
    
            <div class="workspace-header">
    
              <div>
                <span class="label">LIVE EVENT CONTROL</span>
                <h2>Tonight's Players</h2>
              </div>
    
              <button id="registerPlayerButton">
                + REGISTER PLAYER
              </button>
    
            </div>
    
    
            <div class="players-table-wrap">
    
              <table class="players-table">
    
                <thead>
                  <tr>
                    <th>PLAYERS</th>
                    <th>NEW PLAYERS</th>
                    <th>STATUS</th>
                    <th>PHOTO &amp; VIDEO</th>
                    <th>MESSAGE</th>
                    <th>WHERE FROM</th>
                  </tr>
                </thead>
    
                <tbody id="playersTableBody">
    
                  <tr class="empty-table-row">
                    <td colspan="6">
                      No players registered for this event.
                    </td>
                  </tr>
    
                </tbody>
    
              </table>
    
            </div>
    
          </section>
    
    
          <!-- SYSTEM HEALTH -->
    
          <section class="system-health">
    
            <div class="health-card" id="nakkaHealthCard" aria-busy="false">
    
              <span class="label">
                NAKKA API
              </span>
    
              <div class="health-status" role="status" aria-live="polite" aria-atomic="true">
                <span
                  id="nakkaHealthDot"
                  class="health-dot waiting">
                </span>
    
                <strong id="nakkaHealthText">
                  NOT CHECKED
                </strong>
              </div>
    
              <p id="nakkaHealthMessage">
                Health check waiting
              </p>
    
              <div class="health-actions">
                <time id="nakkaHealthTimestamp">No check completed</time>
                <button id="nakkaHealthRefresh" type="button">REFRESH</button>
              </div>
    
              <p class="health-note">
                League read access only. Refreshes every 5 minutes while visible;
                results may be cached for 60 seconds.
              </p>
    
            </div>
    
    
            <div class="health-card">
    
              <span class="label">
                BEAUTY BACKEND
              </span>
    
              <div class="health-status">
                <span
                  id="beautyHealthDot"
                  class="health-dot waiting">
                </span>
    
                <strong id="beautyHealthText">
                  NOT CONNECTED
                </strong>
              </div>
    
              <p id="beautyHealthMessage">
                Google backend waiting
              </p>
    
            </div>
    
          </section>
    
        </main>
    
      </div>
    
    
      <script>
    /* Generated English Hub copy; Swedish remote/kiosk source is preserved. */
    /* Shared, pure name-conflict rules. No service access and no writes. */
    var BeautyNameResolution = (() => {
      const NEW = 'MITT NAMN FINNS INTE I LISTAN';
      const clean = value => String(value || '').normalize('NFC').trim().replace(/\s+/g, ' ');
      const key = value => clean(value).toLocaleLowerCase('sv-SE');
      const error = (code, message) => ({ success: false, code, error: message });
      function resolve(input, master, tonight) {
        const selected = clean(input.selectedName);
        const entered = clean(selected === NEW ? input.newName : selected);
        if (!entered || entered.length > 120 || /^[=+@-]/.test(entered) || /[\x00-\x1f\x7f]/.test(entered)) {
          return error('INVALID_NAME', 'Enter a valid full name.');
        }
        const matches = master.filter(name => key(name) === key(entered));
        if (matches.length > 1) return error('AMBIGUOUS_NAME', 'Several player records have this name. Please ask the organiser for help.');
        const existing = matches[0] === undefined ? null : clean(matches[0]);
        if (selected !== NEW && !existing) return error('UNKNOWN_PLAYER', 'Select your name or add a new player.');
        const alreadyIn = name => tonight.some(player => key(player) === key(name));
        const choice = input.identityChoice || '';
        if (choice && !['existing', 'different'].includes(choice)) return error('INVALID_CHOICE', 'Choose who you are.');
        const conflict = existing && (selected === NEW || alreadyIn(existing));
        if (choice && (!conflict || key(input.identityBase) !== key(existing))) {
          return error('STALE_IDENTITY', 'The selected name has changed. Start again with your name.');
        }
        if (conflict && !choice) return { ...error('NAME_CONFLICT', 'This name is already on the list.'),
          baseName: existing, alreadyRegistered: alreadyIn(existing) };
        if (choice === 'different') {
          const detail = clean(input.identityDetail);
          if (!detail || detail.length > 60 || /[()<>\x00-\x1f\x7f]/.test(detail) || /^[=+@-]/.test(detail)) {
            return { ...error('INVALID_DETAIL', 'Enter your middle name, nickname or another identifying detail.'), baseName: existing };
          }
          // Parentheses preserve the entered full name without guessing which word is a surname.
          const candidate = existing + ' (' + detail + ')';
          if (candidate.length > 120) return { ...error('INVALID_DETAIL', 'The name and identifying detail are too long.'), baseName: existing };
          if (master.some(name => key(name) === key(candidate))) return { ...error('DETAIL_IN_USE',
            'This name with that detail already exists. Select it if it is you, or enter a different detail.'), baseName: existing };
          if (clean(input.identityConfirmedName) !== candidate) return { ...error('CONFIRM_NAME', 'Confirm how your name will be displayed.'), baseName: existing, proposedName: candidate };
          return { success: true, player: candidate, isNew: true };
        }
        if (existing && alreadyIn(existing)) return error('ALREADY_REGISTERED', 'You are already registered for this event.');
        return { success: true, player: existing || entered, isNew: !existing };
      }
      return Object.freeze({ clean, key, resolve, newPlayerOption: NEW });
    })();
    if (typeof module !== 'undefined' && module.exports) module.exports = BeautyNameResolution;
    
    </script>
      <script>
    /* Generated English Hub copy; Swedish remote/kiosk source is preserved. */
    /* One accessible conflict/confirmation dialog shared by Hub, remote and kiosk. */
    var BeautyIdentityDialog = (() => {
      function open(conflict) {
        return new Promise(resolve => {
          const previousFocus = document.activeElement;
          const make = (tag, cls, text) => {
            const el = document.createElement(tag); el.className = cls;
            if (text !== undefined) el.textContent = text;
            return el;
          };
          const overlay = make('div', 'identity-overlay');
          const dialog = make('section', 'identity-dialog');
          dialog.setAttribute('role', 'dialog'); dialog.setAttribute('aria-modal', 'true');
          dialog.setAttribute('aria-label', 'This name already exists');
          const close = make('button', 'identity-close', '×');
          close.type = 'button'; close.setAttribute('aria-label', 'Close');
          const title = make('h2', '', 'This name already exists');
          const name = make('p', 'identity-name', conflict.baseName);
          const help = make('p', '', 'This name is already on the list. Choose THAT IS ME if it is you. If you are a different person, add your middle name, nickname or another detail so we can tell you apart.');
          const me = make('button', 'identity-action', 'THAT IS ME'); me.type = 'button';
          const other = make('button', 'identity-action', 'I AM A DIFFERENT PERSON'); other.type = 'button';
          const area = make('div', 'identity-detail-area'); area.hidden = true;
          const label = make('label', '', 'Middle name, nickname or another identifying detail');
          const input = make('input', 'identity-detail'); input.type = 'text'; input.maxLength = 60;
          input.setAttribute('aria-label', 'Middle name, nickname or another identifying detail');
          label.appendChild(input);
          const info = make('p', 'identity-info'); info.setAttribute('role', 'status');
          if (conflict.code !== 'NAME_CONFLICT') info.textContent = conflict.error || '';
          const preview = make('p', 'identity-preview');
          const proceed = make('button', 'identity-action', 'CONTINUE'); proceed.type = 'button';
          const cancel = make('button', 'identity-cancel', 'CANCEL'); cancel.type = 'button';
          let proposed = '', finished = false;
          const finish = value => {
            if (finished) return; finished = true;
            document.removeEventListener('keydown', onKey);
            overlay.remove(); previousFocus?.focus?.(); resolve(value);
          };
          const onKey = event => {
            if (event.key === 'Escape') { event.preventDefault(); finish(null); }
            if (event.key === 'Tab') {
              const buttons = [close, me, other, ...(area.hidden ? [] : [input, proceed]), cancel];
              const first = buttons[0], last = buttons[buttons.length - 1];
              if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
              else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
            }
          };
          close.addEventListener('click', () => finish(null)); cancel.addEventListener('click', () => finish(null));
          overlay.addEventListener('click', event => { if (event.target === overlay) finish(null); });
          me.addEventListener('click', () => finish({ identityChoice: 'existing', identityBase: conflict.baseName }));
          other.addEventListener('click', () => { area.hidden = false; input.focus(); });
          input.addEventListener('input', () => { proposed = ''; preview.textContent = ''; proceed.textContent = 'CONTINUE'; info.textContent = ''; });
          proceed.addEventListener('click', () => {
            const detail = BeautyNameResolution.clean(input.value);
            const result = BeautyNameResolution.resolve({ selectedName: BeautyNameResolution.newPlayerOption,
              newName: conflict.baseName, identityChoice: 'different', identityBase: conflict.baseName,
              identityDetail: detail }, [conflict.baseName], []);
            if (result.code !== 'CONFIRM_NAME') { info.textContent = result.error; return; }
            if (proposed !== result.proposedName) {
              proposed = result.proposedName; preview.textContent = 'You will be registered as: ' + proposed;
              info.textContent = 'Check the name and press CONFIRM.'; proceed.textContent = 'CONFIRM'; return;
            }
            finish({ identityChoice: 'different', identityBase: conflict.baseName,
              identityDetail: detail, identityConfirmedName: proposed });
          });
          area.appendChild(label); area.appendChild(preview); area.appendChild(proceed);
          for (const el of [close, title, name, help, me, other, area, info, cancel]) dialog.appendChild(el);
          overlay.appendChild(dialog); document.body.appendChild(overlay);
          document.addEventListener('keydown', onKey); close.focus();
        });
      }
      async function submit(send, initial) {
        let data = { ...initial };
        for (;;) {
          // Only explicit user choices can resubmit. Transport errors are never retried.
          const result = await send(data);
          if (!result || !['NAME_CONFLICT', 'INVALID_DETAIL', 'DETAIL_IN_USE', 'CONFIRM_NAME'].includes(result.code)) return result;
          const choice = await open(result);
          if (!choice) return { success: false, code: 'CANCELLED' };
          data = { ...initial, ...choice };
        }
      }
      return Object.freeze({ open, submit });
    })();
    
    </script>
      <script>
    /* Apps Script HTML-service transport, used only by the generated TEST Hub. */
    const BeautyHubServices = (() => {
      const endpoint = 'https://beauty.invalid/hub?page=hubdata';
      const mode = 'test';
      const allowed = ['selectedName', 'newName', 'consent', 'message', 'identityChoice',
        'identityBase', 'identityDetail', 'identityConfirmedName'];
      const errors = {"NAME_CONFLICT": "This name is already on the list.", "ALREADY_REGISTERED": "You are already registered for this event.", "INVALID_NAME": "Enter a valid full name.", "AMBIGUOUS_NAME": "Several player records have this name. Please ask the organiser for help.", "UNKNOWN_PLAYER": "Select your name or add a new player.", "INVALID_CHOICE": "Choose who you are.", "STALE_IDENTITY": "The selected name has changed. Start again.", "INVALID_DETAIL": "Enter a valid middle name, nickname or identifying detail.", "DETAIL_IN_USE": "This identifying detail is already in use. Select the existing player or use a different detail.", "CONFIRM_NAME": "Confirm how your name will be displayed.", "BLOCKED": "This TEST operation is not enabled.", "INVALID": "Invalid request. Check the fields and try again.", "BUSY": "Another operation is running. Reload before trying again.", "STALE_EVENT": "The event date has changed. Reload the Hub.", "STALE_STATUS": "The status has changed since the list loaded. Reload before another change.", "PLAYER_AMBIGUOUS_OR_MISSING": "The player is missing or appears more than once. Reload and check the list.", "FORMULA": "The status cell contains a formula. No change was saved.", "LAYOUT": "The TEST spreadsheet layout needs review.", "READ_FAILED": "The TEST data could not be checked. Reload and inspect the result.", "SAVE_UNCERTAIN": "The save could not be verified. Reload and inspect the result before another change."};
      const response = data => ({ ok: true, json: async () => data?.success === false && data.error ? { ...data, error: errors[data.code] || 'The TEST operation could not be completed. Reload and check the result.' } : data });
      let queue = Promise.resolve();
      function rpcNow(action, input) {
        return new Promise((resolve, reject) => {
          if (typeof google === 'undefined' || !google.script?.run) {
            reject(new Error('Open Hub TEST through Google Apps Script.')); return;
          }
          google.script.run.withSuccessHandler(resolve)
            .withFailureHandler(() => reject(new Error('The Google TEST request failed. Reload and check the result before trying to save again.')))
            .beautyHubTest(action, input);
        });
      }
      function rpc(action, input) {
        const task = queue.then(() => rpcNow(action, input));
        queue = task.catch(() => {});
        return task;
      }
      async function request(raw, options = {}) {
        if (options.signal?.aborted) throw new Error('Aborted');
        const url = new URL(raw);
        const page = url.searchParams.get('page');
        const keys = { hubdata: ['page'], eventcontrol: ['page'], nakkahealth: ['page'], hubregister: ['page', ...allowed], hubstatus: ['page', 'player', 'status', 'expectedStatus', 'eventDate'] }[page];
        if (url.origin !== 'https://beauty.invalid' || url.pathname !== '/hub' ||
            url.username || url.password || url.hash || (options.method && options.method !== 'GET') ||
            !keys || [...url.searchParams.keys()].some(key => !keys.includes(key) || url.searchParams.getAll(key).length !== 1)) {
          throw new Error('Blocked TEST route');
        }
        if (page === 'nakkahealth') return response({ status: 'UNAVAILABLE',
          message: 'TEST — Nakka has not been contacted.', timestamp: new Date().toISOString() });
        const input = Object.fromEntries([...url.searchParams].filter(([key]) => key !== 'page'));
        return response(await rpc(page === 'hubdata' ? 'read' : page === 'eventcontrol' ? 'eventload' : page === 'hubstatus' ? 'status' : 'register', input));
      }
      return Object.freeze({ endpoint, mode, statusWrites: true, request });
    })();
    
    </script>
      <script>
    /*
    =========================================================
    BEAUTY DESKTOP ADMIN HUB
    LIVE BEAUTY DATA CONNECTION
    =========================================================
    */
    
    // Service boundary is closed by default; preview uses in-memory fixtures only.
    const BEAUTY_HUB_URL = BeautyHubServices.endpoint;
    const pendingStatusChanges =
      new Map();
    
    /*
    =========================================================
    LOAD BEAUTY DATA
    =========================================================
    */
    
    async function loadBeautyHubData() {
    
      try {
    
        const response =
          await BeautyHubServices.request(
            BEAUTY_HUB_URL,
            {
              cache: 'no-store'
            }
          );
    
        if (!response.ok) {
          throw new Error(
            `HTTP ${response.status}`
          );
        }
    
        const data =
          await response.json();
    
        if (!data.success) {
          throw new Error(
            data.error ||
            'Beauty backend returned an error.'
          );
        }
    
        updateHub(data);
        setBeautyConnected();
    
      } catch (error) {
    
        console.error(
          'Beauty Hub connection error:',
          error
        );
    
        setBeautyDisconnected(
          error.message
        );
      }
    }
    
    
    /*
    =========================================================
    UPDATE HUB
    =========================================================
    */
    
    function updateHub(data) {
    
      window.beautyHubData = data;
    
      updateEvent(data);
    
      updatePlayerCount(data);
    
      updatePlayersTable(data.players || []);
    }
    
    
    /*
    =========================================================
    EVENT
    =========================================================
    */
    
    function updateEvent(data) {
    
      const eventDate =
        document.getElementById(
          'currentEventDate'
        );
    
      const eventStatus =
        document.getElementById(
          'currentEventStatus'
        );
    
      if (eventDate) {
    
        eventDate.textContent =
          data.eventDateDisplay ||
          'NO EVENT SELECTED';
      }
    
      if (eventStatus) {
    
        eventStatus.textContent =
          data.eventDate
            ? (BeautyHubServices.mode === 'mock' ? 'Preview with fictional players' : 'Beauty event connected')
            : 'No event selected';
      }
    }
    
    
    /*
    =========================================================
    PLAYER COUNT
    =========================================================
    */
    
    function updatePlayerCount(data) {
    
      const playerCount =
        document.getElementById(
          'playerCount'
        );
    
      if (!playerCount) {
        return;
      }
    
      playerCount.textContent =
        String(
          data.playerCount || 0
        );
    }
    
    
    /*
    =========================================================
    TONIGHT'S PLAYERS TABLE
    =========================================================
    */
    
    function updatePlayersTable(players) {
    
      const tableBody =
        document.getElementById(
          'playersTableBody'
        );
    
      if (!tableBody) {
        return;
      }
    
      tableBody.replaceChildren();
    
      if (!players.length) {
    
        const row =
          document.createElement('tr');
    
        const cell =
          document.createElement('td');
    
        cell.colSpan = 6;
    
        cell.textContent =
          'No players registered yet.';
    
        row.appendChild(cell);
        tableBody.appendChild(row);
    
        return;
      }
    
    
      players.forEach(
        player => {
    
          const row =
            document.createElement('tr');
    
          addCell(
            row,
            player.player
          );
    
          addCell(
            row,
            player.newPlayer
          );
    
            const pendingStatus =
      pendingStatusChanges.get(
        player.player
      );
    
    let displayedStatus =
      player.status;
    
    
    /*
    If Beauty has now caught up with
    the status we selected, clear the
    temporary local lock.
    */
    
    if (
      pendingStatus
    ) {
    
      /*
      Keep the Hub-selected status displayed
      while Beauty/Sheets finishes syncing.
    
      Do not allow an older backend value to
      flash back onto the screen.
      */
    
      displayedStatus =
        pendingStatus;
    }
    
    
    addStatusCell(
      row,
      player.player,
      displayedStatus
    );
    
          addConsentCell(
      row,
      player.consent
    );
    
          addMessageCell(
      row,
      player.player,
      player.message
    );
    addCell(
      row,
      player.whereFrom === 'MOBIL' ? 'MOBILE' : player.whereFrom
    );
    
          tableBody.appendChild(row);
        }
      );
    }
    
    /*
    =========================================================
    STATUS DROPDOWN
    =========================================================
    */
    
    /* Injected only into generated Identity TEST HTML, not into the offline preview. */
    function addStatusCell(row, playerName, currentStatus) {
      const cell = document.createElement('td');
      const select = document.createElement('select');
      select.className = 'status-select';
      select.setAttribute('aria-label', 'Status for ' + playerName);
      select.disabled = pendingStatusChanges.has(playerName);
      for (const status of ['IN', 'OUT', 'STANDBY']) {
        const option = document.createElement('option');
        option.value = status; option.textContent = status; option.selected = status === currentStatus;
        select.appendChild(option);
      }
      setStatusClass(select, currentStatus);
      select.addEventListener('change', async () => {
        if (pendingStatusChanges.has(playerName)) return;
        const status = select.value;
        const snapshot = window.beautyHubData;
        const matches = (snapshot?.players || []).filter(p => p.player === playerName);
        if (matches.length !== 1) { select.value = currentStatus; openMessagePopup('Status', 'Reload the player list before changing status.'); return; }
        const expectedStatus = matches[0].status;
        pendingStatusChanges.set(playerName, status);
        select.disabled = true;
        setStatusClass(select, status);
        let refreshNeeded = false;
        try {
          const url = new URL(BEAUTY_HUB_URL);
          for (const [key, value] of Object.entries({ page: 'hubstatus', player: playerName, status,
            expectedStatus, eventDate: snapshot.eventDate })) url.searchParams.set(key, value);
          const result = await (await BeautyHubServices.request(url.toString())).json();
          if (!result.success || result.readbackVerified !== true || !result.data) {
            throw new Error(result.error || 'Status could not be verified. Reload before another change.');
          }
          pendingStatusChanges.delete(playerName);
          updateHub(result.data);
        } catch (error) {
          pendingStatusChanges.delete(playerName);
          refreshNeeded = true;
          select.value = expectedStatus;
          setStatusClass(select, expectedStatus);
          openMessagePopup('Status', error.message);
        } finally {
          select.disabled = false;
          if (refreshNeeded) await loadBeautyHubData();
        }
      });
      cell.appendChild(select); row.appendChild(cell);
    }
    
    function setStatusClass(
      select,
      status
    ) {
    
      select.classList.remove(
        'status-in',
        'status-out',
        'status-standby'
      );
    
    
      if (status === 'IN') {
    
        select.classList.add(
          'status-in'
        );
    
      } else if (
        status === 'OUT'
      ) {
    
        select.classList.add(
          'status-out'
        );
    
      } else if (
        status === 'STANDBY'
      ) {
    
        select.classList.add(
          'status-standby'
        );
      }
    }
    
    /*
    =========================================================
    FOTO & VIDEO CONSENT
    =========================================================
    */
    
    function addConsentCell(
      row,
      consent
    ) {
    
      const cell =
        document.createElement('td');
    
      const badge =
        document.createElement('span');
    
      const cleanConsent =
        String(
          consent || ''
        )
          .trim()
          .toUpperCase();
    
      badge.className =
        'consent-badge';
    
      badge.textContent =
        ({ JA: 'YES', NEJ: 'NO' })[cleanConsent] || cleanConsent || '—';
    
    
      if (
        cleanConsent === 'JA'
      ) {
    
        badge.classList.add(
          'consent-yes'
        );
    
      } else if (
        cleanConsent === 'NEJ'
      ) {
    
        badge.classList.add(
          'consent-no'
        );
    
      } else {
    
        badge.classList.add(
          'consent-unknown'
        );
      }
    
    
      cell.appendChild(
        badge
      );
    
      row.appendChild(
        cell
      );
    }
    /*
    =========================================================
    MESSAGE CELL
    =========================================================
    */
    
    function addMessageCell(
      row,
      playerName,
      message
    ) {
    
      const cell =
        document.createElement('td');
    
      const cleanMessage =
        String(
          message || ''
        ).trim();
    
    
      if (!cleanMessage) {
    
        cell.textContent = '';
    
        row.appendChild(cell);
    
        return;
      }
    
    
      /*
      Short messages can stay visible
      directly in the table.
      */
    
      if (
        cleanMessage.length <= 30
      ) {
    
        cell.textContent =
          cleanMessage;
    
        row.appendChild(cell);
    
        return;
      }
    
    
      /*
      Long messages get a READ button.
      */
    
      const button =
        document.createElement('button');
    
      button.type =
        'button';
    
      button.className =
        'message-read-button';
    
      button.textContent =
        'READ';
    
    
      button.addEventListener(
        'click',
        () => {
    
          openMessagePopup(
            playerName,
            cleanMessage
          );
        }
      );
    
    
      cell.appendChild(button);
    
      row.appendChild(cell);
    }
    
    
    /*
    =========================================================
    MESSAGE POPUP
    =========================================================
    */
    
    function openMessagePopup(
      playerName,
      message
    ) {
    
      const overlay =
        document.createElement('div');
    
      overlay.className =
        'message-popup-overlay';
    
    
      const popup =
        document.createElement('div');
    
      popup.className =
        'message-popup';
    
    
      const closeButton =
        document.createElement('button');
    
      closeButton.type =
        'button';
    
      closeButton.className =
        'message-popup-close';
    
      closeButton.textContent =
        '×';
    
    
      const label =
        document.createElement('div');
    
      label.className =
        'message-popup-label';
    
      label.textContent =
        'MESSAGE';
    
    
      const title =
        document.createElement('h2');
    
      title.textContent =
        playerName;
    
    
      const text =
        document.createElement('div');
    
      text.className =
        'message-popup-text';
    
      text.textContent =
        message;
    
    
      function closePopup() {
    
        overlay.remove();
      }
    
    
      closeButton.addEventListener(
        'click',
        closePopup
      );
    
    
      overlay.addEventListener(
        'click',
        event => {
    
          if (
            event.target === overlay
          ) {
    
            closePopup();
          }
        }
      );
    
    
      popup.appendChild(
        closeButton
      );
    
      popup.appendChild(
        label
      );
    
      popup.appendChild(
        title
      );
    
      popup.appendChild(
        text
      );
    
      overlay.appendChild(
        popup
      );
    
      document.body.appendChild(
        overlay
      );
    }
    
    /*
    =========================================================
    SAFE TABLE CELL
    =========================================================
    */
    
    function addCell(
      row,
      value
    ) {
    
      const cell =
        document.createElement('td');
    
      cell.textContent =
        value || '';
    
      row.appendChild(cell);
    }
    
    
    /*
    =========================================================
    BEAUTY BACKEND STATUS
    =========================================================
    */
    
    function setBeautyConnected() {
    
      const dot =
        document.getElementById(
          'beautyHealthDot'
        );
    
      const text =
        document.getElementById(
          'beautyHealthText'
        );
    
      const message =
        document.getElementById(
          'beautyHealthMessage'
        );
    
      if (dot) {
        dot.classList.add(
          'connected'
        );
      }
    
      if (text) {
        text.textContent =
          'TEST CONNECTED';
      }
    
      if (message) {
        message.textContent =
          'Google Sheets — separate Identity TEST';
      }
    }
    
    
    function setBeautyDisconnected(
      errorMessage
    ) {
    
      const dot =
        document.getElementById(
          'beautyHealthDot'
        );
    
      const text =
        document.getElementById(
          'beautyHealthText'
        );
    
      const message =
        document.getElementById(
          'beautyHealthMessage'
        );
    
      if (dot) {
        dot.classList.remove(
          'connected'
        );
      }
    
      if (text) {
        text.textContent =
          'PROBLEM';
      }
    
      if (message) {
        message.textContent =
          errorMessage ||
          'Google backend unavailable';
      }
    }
    
    /*
    =========================================================
    REGISTER PLAYER
    =========================================================
    */
    
    const registerPlayerButton =
      document.getElementById(
        'registerPlayerButton'
      );
    
    if (registerPlayerButton) {
    
      registerPlayerButton.addEventListener(
        'click',
        () => {
    
          openRegisterPlayerPopup();
    
        }
      );
    }
    
    
    function openRegisterPlayerPopup() {
    
      const overlay =
        document.createElement('div');
    
      overlay.className =
        'register-popup-overlay';
    
    
      const popup =
        document.createElement('div');
    
      popup.className =
        'register-popup kiosk-register-popup';
    
    
      const closeButton =
        document.createElement('button');
    
      closeButton.type =
        'button';
    
      closeButton.className =
        'register-popup-close';
    
      closeButton.textContent =
        '×';
    
    
      const label =
        document.createElement('div');
    
      label.className =
        'register-popup-label';
    
      label.textContent =
        'BEAUTY REGISTRATION';
    
    
      const title =
        document.createElement('h2');
    
      title.textContent =
        'Register Player';
    
    
      const description =
        document.createElement('p');
    
      description.className =
        'register-popup-description';
    
      description.textContent =
        'Register a player directly from the Beauty Hub.';
    
    
      const errorBox =
        document.createElement('div');
    
      errorBox.className =
        'hub-register-error';
    
      errorBox.style.display =
        'none';
    
    
      /* =========================================================
         PLAYER
         ========================================================= */
    
      const playerField =
        document.createElement('div');
    
      playerField.className =
        'hub-kiosk-field hub-kiosk-player-field';
    
    
      const playerHeading =
        document.createElement('div');
    
      playerHeading.className =
        'hub-kiosk-label';
    
      playerHeading.innerHTML =
        'SELECT YOUR NAME <span>*</span>';
    
    
      const playerHelp =
        document.createElement('div');
    
      playerHelp.className =
        'hub-kiosk-help';
    
      playerHelp.innerHTML =
        'Cannot find your name? Select <strong>MY NAME IS NOT ON THE LIST</strong>, then enter your full name.';
    
    
      const playerDropdown =
        document.createElement('div');
    
      playerDropdown.className =
        'hub-kiosk-player-dropdown';
    
    
      const playerTrigger =
        document.createElement('button');
    
      playerTrigger.type =
        'button';
    
      playerTrigger.className =
        'hub-kiosk-player-trigger';
    
      playerTrigger.innerHTML =
        '<span class="hub-kiosk-player-trigger-text">Select...</span><span class="hub-kiosk-player-arrow">▼</span>';
    
    
      const playerMenu =
        document.createElement('div');
    
      playerMenu.className =
        'hub-kiosk-player-menu';
    
    
      const playerSearch =
        document.createElement('input');
    
      playerSearch.type =
        'text';
    
      playerSearch.className =
        'hub-kiosk-player-search';
    
      playerSearch.placeholder =
        'Search for your name...';
    
    
      const newPlayerOption =
        document.createElement('button');
    
      newPlayerOption.type =
        'button';
    
      newPlayerOption.className =
        'hub-kiosk-player-option hub-kiosk-new-player';
    
      newPlayerOption.textContent =
        'MY NAME IS NOT ON THE LIST';
    
    
      const playerList =
        document.createElement('div');
    
      playerList.className =
        'hub-kiosk-player-list';
    
    
      const playerValue =
        document.createElement('input');
    
      playerValue.type =
        'hidden';
    
      playerValue.id =
        'hubRegisterPlayer';
    
    
      const masterPlayers =
        window.beautyHubData &&
        Array.isArray(
          window.beautyHubData.masterPlayers
        )
          ? window.beautyHubData.masterPlayers
          : [];
    
    
      masterPlayers.forEach(
        playerName => {
    
          if (
            playerName ===
            'MITT NAMN FINNS INTE I LISTAN'
          ) {
            return;
          }
    
          const playerButton =
            document.createElement('button');
    
          playerButton.type =
            'button';
    
          playerButton.className =
            'hub-kiosk-player-option';
    
          playerButton.textContent =
            playerName;
    
          playerButton.dataset.playerName =
            playerName;
    
          playerList.appendChild(
            playerButton
          );
        }
      );
    
    
      playerMenu.appendChild(
        playerSearch
      );
    
      playerMenu.appendChild(
        newPlayerOption
      );
    
      playerMenu.appendChild(
        playerList
      );
    
      playerDropdown.appendChild(
        playerTrigger
      );
    
      playerDropdown.appendChild(
        playerMenu
      );
    
      playerDropdown.appendChild(
        playerValue
      );
    
    
      const newPlayerArea =
        document.createElement('div');
    
      newPlayerArea.className =
        'hub-kiosk-new-player-area';
    
      newPlayerArea.style.display =
        'none';
    
    
      const newPlayerHeading =
        document.createElement('div');
    
      newPlayerHeading.className =
        'hub-kiosk-label';
    
      newPlayerHeading.innerHTML =
        'ENTER YOUR FULL NAME <span>*</span>';
    
    
      const newNameInput =
        document.createElement('input');
    
      newNameInput.type =
        'text';
    
      newNameInput.id =
        'hubRegisterNewName';
    
      newNameInput.className =
        'hub-kiosk-new-name';
    
      newNameInput.placeholder =
        'First name Last name';
    
    
      newPlayerArea.appendChild(
        newPlayerHeading
      );
    
      newPlayerArea.appendChild(
        newNameInput
      );
    
    
      function resetPlayerFilter() {
    
        playerSearch.value =
          '';
    
        playerList
          .querySelectorAll(
            '.hub-kiosk-player-option'
          )
          .forEach(
            button => {
    
              button.style.display =
                'block';
            }
          );
      }
    
    
      function closePlayerMenu() {
    
        playerMenu.classList.remove(
          'open'
        );
      }
    
    
      function setPlayer(
        playerName
      ) {
    
        playerValue.value =
          playerName;
    
        const triggerText =
          playerTrigger.querySelector(
            '.hub-kiosk-player-trigger-text'
          );
    
        triggerText.textContent =
          playerName === 'MITT NAMN FINNS INTE I LISTAN' ? 'MY NAME IS NOT ON THE LIST' : playerName;
    
        const isNewPlayer =
          playerName ===
          'MITT NAMN FINNS INTE I LISTAN';
    
        newPlayerArea.style.display =
          isNewPlayer
            ? 'block'
            : 'none';
    
        if (!isNewPlayer) {
    
          newNameInput.value =
            '';
        }
    
        resetPlayerFilter();
    
        closePlayerMenu();
    
        if (isNewPlayer) {
    
          setTimeout(
            () => {
              newNameInput.focus();
            },
            50
          );
        }
      }
    
    
      playerTrigger.addEventListener(
        'click',
        () => {
    
          playerMenu.classList.toggle(
            'open'
          );
    
          if (
            playerMenu.classList.contains(
              'open'
            )
          ) {
    
            setTimeout(
              () => {
                playerSearch.focus();
              },
              50
            );
          }
        }
      );
    
    
      playerSearch.addEventListener(
        'input',
        () => {
    
          const searchValue =
            playerSearch.value
              .trim()
              .toLocaleLowerCase(
                'sv-SE'
              );
    
          playerList
            .querySelectorAll(
              '.hub-kiosk-player-option'
            )
            .forEach(
              button => {
    
                const playerName =
                  button.dataset.playerName
                    .toLocaleLowerCase(
                      'sv-SE'
                    );
    
                button.style.display =
                  playerName.includes(
                    searchValue
                  )
                    ? 'block'
                    : 'none';
              }
            );
        }
      );
    
    
      playerList.addEventListener(
        'click',
        event => {
    
          const button =
            event.target.closest(
              '.hub-kiosk-player-option'
            );
    
          if (!button) {
            return;
          }
    
          setPlayer(
            button.dataset.playerName
          );
        }
      );
    
    
      newPlayerOption.addEventListener(
        'click',
        () => {
    
          setPlayer(
            'MITT NAMN FINNS INTE I LISTAN'
          );
        }
      );
    
    
      playerField.appendChild(
        playerHeading
      );
    
      playerField.appendChild(
        playerHelp
      );
    
      playerField.appendChild(
        playerDropdown
      );
    
      playerField.appendChild(
        newPlayerArea
      );
    
    
      /* =========================================================
         FOTO OCH VIDEO
         ========================================================= */
    
      const consentField =
        document.createElement('div');
    
      consentField.className =
        'hub-kiosk-field hub-kiosk-white-field';
    
    
      const consentHeading =
        document.createElement('div');
    
      consentHeading.className =
        'hub-kiosk-label';
    
      consentHeading.innerHTML =
        'PHOTO & VIDEO <span>*</span>';
    
    
      const consentOptions =
        document.createElement('div');
    
      consentOptions.className =
        'hub-kiosk-consent-options';
    
    
      const consentYes =
        document.createElement('button');
    
      consentYes.type =
        'button';
    
      consentYes.className =
        'hub-kiosk-consent-button';
    
      consentYes.dataset.value =
        'JA, JAG GODKÄNNER';
    
      consentYes.textContent =
        'YES, I CONSENT';
    
    
      const consentNo =
        document.createElement('button');
    
      consentNo.type =
        'button';
    
      consentNo.className =
        'hub-kiosk-consent-button';
    
      consentNo.dataset.value =
        'NEJ, JAG GODKÄNNER INTE';
    
      consentNo.textContent =
        'NO, I DO NOT CONSENT';
    
    
      let selectedConsent =
        '';
    
    
      function selectConsent(
        button
      ) {
    
        consentOptions
          .querySelectorAll(
            '.hub-kiosk-consent-button'
          )
          .forEach(
            item => {
    
              item.classList.remove(
                'selected'
              );
            }
          );
    
        button.classList.add(
          'selected'
        );
    
        selectedConsent =
          button.dataset.value;
      }
    
    
      consentYes.addEventListener(
        'click',
        () => {
          selectConsent(
            consentYes
          );
        }
      );
    
      consentNo.addEventListener(
        'click',
        () => {
          selectConsent(
            consentNo
          );
        }
      );
    
    
      consentOptions.appendChild(
        consentYes
      );
    
      consentOptions.appendChild(
        consentNo
      );
    
    
      const consentHelp =
        document.createElement('div');
    
      consentHelp.className =
        'hub-kiosk-help';
    
      consentHelp.textContent =
        'Your answer indicates whether AIK Dartförening may use photos and videos featuring you.';
    
    
      consentField.appendChild(
        consentHeading
      );
    
      consentField.appendChild(
        consentOptions
      );
    
      consentField.appendChild(
        consentHelp
      );
    
    
      /* =========================================================
         MESSAGE
         ========================================================= */
    
      const messageField =
        document.createElement('div');
    
      messageField.className =
        'hub-kiosk-field hub-kiosk-white-field';
    
    
      const messageHeading =
        document.createElement('div');
    
      messageHeading.className =
        'hub-kiosk-label';
    
      messageHeading.textContent =
        'MESSAGE';
    
    
      const messageInput =
        document.createElement('textarea');
    
      messageInput.id =
        'hubRegisterMessage';
    
      messageInput.className =
        'hub-kiosk-message';
    
      messageInput.placeholder =
        'Optional — for example, I will be about 15 minutes late.';
    
    
      messageField.appendChild(
        messageHeading
      );
    
      messageField.appendChild(
        messageInput
      );
    
    
      /* =========================================================
         ACTIONS
         ========================================================= */
    
      const actions =
        document.createElement('div');
    
      actions.className =
        'hub-kiosk-actions';
    
    
      const cancelButton =
        document.createElement('button');
    
      cancelButton.type =
        'button';
    
      cancelButton.className =
        'hub-kiosk-cancel';
    
      cancelButton.textContent =
        'CANCEL';
    
    
      const submitButton =
        document.createElement('button');
    
      submitButton.type =
        'button';
    
      submitButton.className =
        'hub-kiosk-submit';
    
      submitButton.textContent =
        'REGISTER PLAYER';
    
    
      function showError(
        message
      ) {
    
        // Keep registration feedback visible in the same dismissible popup as messages.
        // The form stays open underneath so the player selection is preserved.
        errorBox.style.display = 'none';
        openMessagePopup('Registration', message);
      }
    
    
      function hideError() {
    
        errorBox.style.display =
          'none';
    
        errorBox.textContent =
          '';
      }
    
    
      function closePopup() {
    
        overlay.remove();
      }
    
    
      closeButton.addEventListener(
        'click',
        closePopup
      );
    
      cancelButton.addEventListener(
        'click',
        closePopup
      );
    
      overlay.addEventListener(
        'click',
        event => {
    
          if (
            event.target === overlay
          ) {
    
            closePopup();
          }
        }
      );
    
    
      submitButton.addEventListener(
      'click',
      async () => {
    
        hideError();
    
        if (!playerValue.value) {
    
          showError(
            'Select your name.'
          );
    
          return;
        }
    
        if (
          playerValue.value ===
            'MITT NAMN FINNS INTE I LISTAN' &&
          !newNameInput.value.trim()
        ) {
    
          showError(
            'Enter your full name.'
          );
    
          return;
        }
    
        if (!selectedConsent) {
    
          showError(
            'Select YES or NO for photos and video.'
          );
    
          return;
        }
    
    
        const originalText =
          submitButton.textContent;
    
        submitButton.disabled =
          true;
    
        submitButton.textContent =
          'REGISTERING...';
    
    
        try {
    
          const initial = { selectedName: playerValue.value, newName: newNameInput.value.trim(),
            consent: selectedConsent, message: messageInput.value.trim() };
          const result = await BeautyIdentityDialog.submit(async payload => {
            const url = new URL(BEAUTY_HUB_URL);
            url.searchParams.set('page', 'hubregister');
            for (const [key, value] of Object.entries(payload)) url.searchParams.set(key, value);
            const response = await BeautyHubServices.request(url.toString(), { cache: 'no-store' });
            if (!response.ok) throw new Error('The registration service could not be reached.');
            return response.json();
          }, initial);
          if (result?.code === 'CANCELLED') {
            submitButton.disabled = false; submitButton.textContent = originalText; return;
          }
    
          if (!result.success) {
    
            throw new Error(
              result.error ||
              'The registration could not be saved.'
            );
          }
    
    
          closePopup();
    
          await loadBeautyHubData();
    
    
        } catch (error) {
    
          console.error(
            'Hub registration error:',
            error
          );
    
          showError(
            error.message ||
            'The registration could not be saved.'
          );
    
          submitButton.disabled =
            false;
    
          submitButton.textContent =
            originalText;
        }
      }
    );
    
    
      actions.appendChild(
        cancelButton
      );
    
      actions.appendChild(
        submitButton
      );
    
    
      popup.appendChild(
        closeButton
      );
    
      popup.appendChild(
        title
      );
    
      popup.appendChild(
        errorBox
      );
    
      popup.appendChild(
        playerField
      );
    
      popup.appendChild(
        consentField
      );
    
      popup.appendChild(
        messageField
      );
    
      popup.appendChild(
        actions
      );
    
    
      overlay.appendChild(
        popup
      );
    
      document.body.appendChild(
        overlay
      );
    }
    
    /*
    =========================================================
    START HUB
    =========================================================
    */
    
    loadBeautyHubData();
    
    setInterval(
      loadBeautyHubData,
      15000
    );
    </script>
      <script>
    /* Independent from the existing five-second Beauty data/status polling. */
    (() => {
      const REFRESH_INTERVAL_MS = 5 * 60 * 1000;
      const MANUAL_COOLDOWN_MS = 60 * 1000;
      const REQUEST_TIMEOUT_MS = 15 * 1000;
    
      const card = document.getElementById('nakkaHealthCard');
      const dot = document.getElementById('nakkaHealthDot');
      const status = document.getElementById('nakkaHealthText');
      const message = document.getElementById('nakkaHealthMessage');
      const timestamp = document.getElementById('nakkaHealthTimestamp');
      const refresh = document.getElementById('nakkaHealthRefresh');
    
      if (!card || !dot || !status || !message || !timestamp || !refresh) {
        return;
      }
    
      let inFlight = false;
      let nextAllowedAt = 0;
      let lastStartedAt = 0;
      let cooldownTimer;
    
      function updateRefreshButton() {
        clearTimeout(cooldownTimer);
        const remaining = Math.max(0, nextAllowedAt - Date.now());
        refresh.disabled = inFlight || remaining > 0;
        refresh.textContent = inFlight ? 'CHECKING…' : 'REFRESH';
        refresh.title = remaining > 0
          ? 'Refresh is available once per minute.'
          : 'Check Nakka league access';
    
        if (remaining > 0) {
          cooldownTimer = setTimeout(updateRefreshButton, remaining);
        }
      }
    
      function renderHealth(health) {
        status.textContent = health.status;
        dot.classList.remove('waiting', 'ok', 'degraded', 'problem');
        dot.classList.add({ OK: 'ok', DEGRADED: 'degraded', UNAVAILABLE: 'problem' }[health.status]);
        message.textContent = health.message;
        timestamp.dateTime = health.timestamp;
        timestamp.textContent = 'Checked: ' + new Date(health.timestamp).toLocaleString();
      }
    
      async function loadNakkaHealth() {
        if (document.hidden || inFlight || Date.now() < nextAllowedAt) {
          return;
        }
    
        inFlight = true;
        lastStartedAt = Date.now();
        nextAllowedAt = lastStartedAt + MANUAL_COOLDOWN_MS;
        card.setAttribute('aria-busy', 'true');
        // Never leave an old OK result looking current while a refresh is pending.
        status.textContent = 'CHECKING';
        dot.classList.remove('ok', 'degraded', 'problem');
        dot.classList.add('waiting');
        message.textContent = 'Checking Nakka league access…';
        updateRefreshButton();
    
        const controller = new AbortController();
        const timeout = setTimeout(() => controller.abort(), REQUEST_TIMEOUT_MS);
    
        try {
          // Reuse the existing backend URL; credentials remain in Apps Script.
          const url = new URL(BEAUTY_HUB_URL);
          url.searchParams.set('page', 'nakkahealth');
    
          const response = await BeautyHubServices.request(url.toString(), {
            cache: 'no-store',
            signal: controller.signal
          });
    
          if (!response.ok) {
            throw new Error('Health endpoint unavailable');
          }
    
          const health = await response.json();
          if (
            !health ||
            !['OK', 'DEGRADED', 'UNAVAILABLE'].includes(health.status) ||
            typeof health.message !== 'string' ||
            !health.message.trim() ||
            typeof health.timestamp !== 'string' ||
            !Number.isFinite(Date.parse(health.timestamp))
          ) {
            throw new Error('Invalid health response');
          }
    
          renderHealth(health);
        } catch (error) {
          // Do not display response bodies or raw exceptions from the backend.
          renderHealth({
            status: 'UNAVAILABLE',
            message: controller.signal.aborted
              ? 'The health check timed out. Nakka health could not be confirmed.'
              : 'The health endpoint could not be reached or returned an invalid response.',
            timestamp: new Date().toISOString()
          });
        } finally {
          clearTimeout(timeout);
          inFlight = false;
          card.setAttribute('aria-busy', 'false');
          updateRefreshButton();
        }
      }
    
      refresh.addEventListener('click', loadNakkaHealth);
      document.addEventListener('visibilitychange', () => {
        if (!document.hidden && Date.now() - lastStartedAt >= REFRESH_INTERVAL_MS) {
          loadNakkaHealth();
        }
      });
    
      loadNakkaHealth();
      setInterval(loadNakkaHealth, REFRESH_INTERVAL_MS);
    })();
    
    </script>
      <script>
    /* Accidental-change review guard. This is not authentication or a write API. */
    var BeautyEventDateGuard = (() => {
      function validDate(value) {
        if (typeof value !== 'string' || !/^[1-9]\d{3}-\d{2}-\d{2}$/.test(value)) return false;
        const date = new Date(value + 'T00:00:00Z');
        return !isNaN(date.getTime()) && date.toISOString().slice(0, 10) === value;
      }
      function canReview(state) {
        return state.loaded === true && state.blocked === false && validDate(state.currentDate) &&
          validDate(state.newDate) && state.newDate !== state.currentDate &&
          state.acknowledged === true;
      }
      return Object.freeze({ validDate, canReview });
    })();
    if (typeof module !== 'undefined') module.exports = BeautyEventDateGuard;
    
    </script>
      <script>
    /* English Hub Event Control. Review only; event saving has no client/server route. */
    (() => {
      let active = null;
      function openPanel(kind) {
        if (active) return;
        const previous = document.activeElement;
        const make = (tag, text, cls) => { const el = document.createElement(tag); if (text !== undefined) el.textContent = text; if (cls) el.className = cls; return el; };
        const overlay = make('div', undefined, 'message-popup-overlay');
        const panel = make('section', undefined, 'message-popup event-inspection');
        panel.setAttribute('role', 'dialog'); panel.setAttribute('aria-modal', 'true'); panel.setAttribute('aria-label', kind === 'details' ? 'Event Control Details' : 'Event Control');
        const close = make('button', '×', 'message-popup-close'); close.type = 'button'; close.setAttribute('aria-label', 'Close');
        const title = make('h2', kind === 'details' ? 'EVENT CONTROL DETAILS — TEST' : 'EVENT CONTROL — TEST');
        const content = make('div', 'Loading event…'); content.setAttribute('role', 'status');
        const edit = make('div');
        const label = make('label', 'New event date');
        const date = make('input'); date.type = 'date'; date.disabled = true; date.setAttribute('aria-label', 'New event date'); label.appendChild(date);
        const ackLabel = make('label', undefined, 'event-acknowledgement');
        const ack = make('input'); ack.type = 'checkbox'; ack.disabled = true; ack.setAttribute('aria-label', 'I understand that changing the date resets event data');
        ackLabel.appendChild(ack); ackLabel.appendChild(make('span', 'I understand that changing the date resets event data.'));
        const review = make('button', 'REVIEW CHANGE'); review.type = 'button'; review.disabled = true;
        const reviewArea = make('div'); reviewArea.hidden = true;
        const reviewText = make('p');
        const unavailable = make('button', 'CONFIRM DATE CHANGE — NOT ENABLED'); unavailable.type = 'button'; unavailable.disabled = true;
        const back = make('button', 'CANCEL CHANGE'); back.type = 'button';
        reviewArea.appendChild(reviewText); reviewArea.appendChild(unavailable); reviewArea.appendChild(back);
        const note = make('p', 'Inspection only. Saving is not enabled. Reset details are available from Event Control Details in the sidebar.');
        const reload = make('button', 'RELOAD EVENT'); reload.type = 'button'; reload.disabled = true;
        const cancel = make('button', 'CLOSE'); cancel.type = 'button';
        const state = { loaded: false, blocked: true, currentDate: '', newDate: '', acknowledged: false };
        let generation = 0;
        function controls() { review.disabled = !BeautyEventDateGuard.canReview(state); }
        function resetReview() { state.acknowledged = false; ack.checked = false; reviewArea.hidden = true; edit.hidden = false; title.textContent = kind === 'details' ? 'EVENT CONTROL DETAILS — TEST' : 'EVENT CONTROL — TEST'; controls(); }
        function dismiss() { if (active !== overlay) return; generation++; active = null; overlay.remove(); document.removeEventListener('keydown', keys); previous?.focus(); }
        function keys(e) {
          if (e.key === 'Escape') { e.preventDefault(); dismiss(); }
          if (e.key === 'Tab') {
            const list = [close, ...(kind === 'control' ? (reviewArea.hidden ? [date, ack, review] : [back]) : []), reload, cancel].filter(el => !el.disabled);
            const first = list[0], last = list[list.length - 1];
            if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
            else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
          }
        }
        function line(label, value) { content.appendChild(make('p', label + ': ' + String(value ?? '—'))); }
        async function load() {
          const token = ++generation; state.loaded = false; state.blocked = true; resetReview(); reload.disabled = true;
          date.disabled = ack.disabled = true; content.textContent = 'Loading event…';
          try {
            const url = new URL(BeautyHubServices.endpoint); url.searchParams.set('page', 'eventcontrol');
            const result = await (await BeautyHubServices.request(url.toString())).json();
            if (active !== overlay || token !== generation) return;
            if (!result.success || result.inspectionOnly !== true || result.writesEnabled !== false) throw new Error(result.error || 'Unexpected Event Control response.');
            content.textContent = '';
            state.loaded = true; state.currentDate = result.eventDate || ''; state.newDate = state.currentDate;
            state.blocked = Boolean(result.blockers?.length); date.value = state.newDate;
            line('Current event', state.currentDate || 'Unavailable');
            if (kind === 'details') {
              line('Test spreadsheet', result.spreadsheet?.title); line('Time zone', result.spreadsheet?.timeZone); line('Locale', result.spreadsheet?.locale);
              line('Last reset', result.lastResetDisplay);
              if (result.resetPlan) {
                const p = result.resetPlan;
                line('Current players', p.visiblePlayers); line('Last response row', p.responseRows);
                line('Event-status rows deleted by the legacy reset', p.deleteStatusRows);
                line('Name-correction rows retained', p.retainNameCorrectionRows);
                line('Retained event cells cleared (C:E)', p.clearRetainedEventCells);
                line('Other reset targets', 'Control A2/B2 and Tonight\'s Players C2:C100');
                line('Preserved', 'Permanent master list and registration responses');
              }
              for (const message of result.blockers || []) line('Review required', message);
              for (const message of result.warnings || []) line('Notice', message);
              line('Scope', 'Read-only inspection. A reset plan applies only to a changed event date. Future membership is not predicted.');
            } else {
              if (state.blocked) line('Date change unavailable', 'Review the issues in Event Control Details.');
              date.disabled = ack.disabled = state.blocked;
            }
            controls();
          } catch (error) { if (active === overlay && token === generation) content.textContent = error.message; }
          finally { if (active === overlay && token === generation) reload.disabled = false; }
        }
        date.addEventListener('input', () => { state.newDate = date.value; resetReview(); });
        ack.addEventListener('change', () => { state.acknowledged = ack.checked; controls(); });
        review.addEventListener('click', () => {
          if (!BeautyEventDateGuard.canReview(state)) return;
          edit.hidden = true; reviewArea.hidden = false; title.textContent = 'CONFIRM DATE CHANGE — TEST';
          reviewText.textContent = 'Change the event date from ' + state.currentDate + ' to ' + state.newDate + '? This will reset event data. Confirmation is unavailable until event saving is enabled. Nothing has been saved.';
          back.focus();
        });
        back.addEventListener('click', () => { resetReview(); date.focus(); });
        close.addEventListener('click', dismiss); cancel.addEventListener('click', dismiss); reload.addEventListener('click', load);
        overlay.addEventListener('click', e => { if (e.target === overlay) dismiss(); });
        for (const element of [label, ackLabel, review]) edit.appendChild(element);
        for (const element of [close, title, content, ...(kind === 'control' ? [edit, reviewArea, note] : []), reload, cancel]) panel.appendChild(element);
        overlay.appendChild(panel); document.body.appendChild(overlay); active = overlay; document.addEventListener('keydown', keys); close.focus(); load();
      }
      for (const button of document.querySelectorAll('.event-button, .sidebar button')) {
        const text = button.textContent.trim().toLocaleLowerCase();
        if (button.classList.contains('event-button') || text === 'event control') button.addEventListener('click', () => openPanel('control'));
        else if (text === 'event control details') button.addEventListener('click', () => openPanel('details'));
      }
    })();
    
    </script>
    
    </body>
    </html>
    
  actual: |-
    <!DOCTYPE html>
    <html lang="en">
    <head>
      <base target="_top">
      <meta charset="UTF-8">
      <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
