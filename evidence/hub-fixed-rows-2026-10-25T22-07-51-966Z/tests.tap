    .event-brand-logo { display: block; width: clamp(220px, 25vw, 340px); height: auto; flex: 0 1 auto; max-width: 100%; }
    .event-header .event-button { flex-shrink: 0; }
    @media (max-width: 900px) {
      .topbar { padding: 16px 20px; gap: 16px; }
