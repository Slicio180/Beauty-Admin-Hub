+// A cache hint only: eviction or any failure preserves the existing lease fallback.
+// It contains hashes/times, never player cells, credentials or provider responses.
+function beautyBackgroundRecheckSignalKey_(owner) {
+  beautyBackgroundNeed_(typeof owner==='string'&&/^[A-Za-z0-9_-]{1,80}$/.test(owner),'BACKGROUND_CLAIM_REQUIRED');
+  return 'BEAUTY_RECHECK_FINISHED_V1_'+owner;
+}
+function beautyBackgroundRecheckSignal_() {
+  try {
+    const i=beautyBackgroundInvocation_;
+    if(!i||i.operation!=='registration-recheck'||i.lock.hasLock()||Date.now()>=i.expires||
+      typeof i.recheckRunRaw!=='string'||typeof i.configRaw!=='string')return false;
+    const r=JSON.parse(i.recheckRunRaw);
+    if(r.state!=='RUNNING'||r.operation!==i.operation||r.owner!==i.owner||r.player!==i.player||
+      r.triggerUid!==i.triggerUid||r.leaseUntil!==i.expires||
+      r.timing?.workerMode!=='verified-recheck-defer-v4'||!beautyBackgroundEqual_(r.context,i.context))return false;
+    const key=beautyBackgroundRecheckSignalKey_(i.owner),cache=CacheService.getScriptCache();
+    const raw=JSON.stringify({version:1,reason:'COMMIT_BUSY',runHash:beautyHubTransferHash_(i.recheckRunRaw),
+      configHash:beautyHubTransferHash_(i.configRaw),finishedAt:new Date().toISOString()});
+    cache.put(key,raw,600);return cache.get(key)===raw;
+  }catch(ignore){return false;}
+}
+function beautyBackgroundRecheckRetire_(previousRaw,context,config,lock) {
+  const c=beautyBackgroundConfig_(),p=PropertiesService.getScriptProperties();let previous,marker,key,configRaw;
+  try {
+    if(!lock?.hasLock()||ScriptApp.getScriptId()!==c.scriptId||
+      Session.getEffectiveUser().getEmail().toLowerCase()!==c.owner||config?.state!=='ENABLED')return false;
+    previous=JSON.parse(previousRaw||'null');
+    if(previous?.state!=='RUNNING'||previous.operation!=='registration-recheck'||
+      previous.timing?.workerMode!=='verified-recheck-defer-v4'||previous.triggerUid!==config.triggerUid||
+      !beautyBackgroundEqual_(previous.context,context)||!Number.isFinite(previous.leaseUntil)||
+      Date.now()>=previous.leaseUntil)return false;
+    key=beautyBackgroundRecheckSignalKey_(previous.owner);
+    marker=JSON.parse(CacheService.getScriptCache().get(key)||'null');
+    if(!marker||Object.keys(marker).sort().join(',')!=='configHash,finishedAt,reason,runHash,version'||
+      marker.version!==1||marker.reason!=='COMMIT_BUSY'||marker.runHash!==beautyHubTransferHash_(previousRaw)||
+      typeof marker.finishedAt!=='string')return false;
+    const ended=Date.parse(marker.finishedAt),started=Date.parse(previous.startedAt);
+    if(!Number.isFinite(ended)||!Number.isFinite(started)||ended<started||ended>Date.now()||ended>=previous.leaseUntil)return false;
+    configRaw=p.getProperty(c.key);
+    if(marker.configHash!==beautyHubTransferHash_(configRaw)||!beautyBackgroundEqual_(JSON.parse(configRaw),config)||
+      !beautyBackgroundEqual_(beautyBackgroundScope_(),context))return false;
+    // Re-read after context services. A stale/changed claim never grants authority.
+    if(!lock.hasLock()||Date.now()>=previous.leaseUntil||p.getProperty(c.runKey)!==previousRaw||
+      p.getProperty(c.key)!==configRaw||Session.getEffectiveUser().getEmail().toLowerCase()!==c.owner)return false;
+  }catch(ignore){return false;}
+  const finishedAt=new Date().toISOString(),retired={...previous,state:'FINISHED',finishedAt,
+    result:{operation:'registration-recheck',player:previous.player,verified:false,committed:false,
+      code:'BACKGROUND_RECHECK_DEFERRED',lastVerifiedRetained:true,nakkaWrites:0},
+    deferral:{reason:'COMMIT_BUSY',reportedAt:marker.finishedAt,retiredAt:finishedAt}};
+  // Only the locked terminal run record changes. Player state and provider work
+  // are untouched; ordinary selection and all fresh guards run again afterward.
+  try{beautyBackgroundSave_(c.runKey,retired);}catch(ignore){return false;}
+  try{CacheService.getScriptCache().remove(key);}catch(ignore){}
+  console.log(JSON.stringify({type:'BEAUTY_BACKGROUND_RECHECK_RELEASED',owner:previous.owner,
+    triggerUid:previous.triggerUid,reportedAt:marker.finishedAt,retiredAt:finishedAt,
+    delayMs:Date.now()-Date.parse(marker.finishedAt),leaseUnchanged:true,nakkaWrites:0}));
+  return true;
+}
